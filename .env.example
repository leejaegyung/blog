# docker compose가 읽는 공통 환경변수. `cp .env.example .env` 후 APP_KEY를 채운다.
APP_NAME="Blog AI"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
APP_PORT=8080
APP_LOCALE=ko
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
# 한 줄 JSON 로그(trace_id 포함)
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

SESSION_LIFETIME=120

# 1인용 로컬 자동 로그인: 로그인 화면 없이 이 계정으로 들어간다.
# 포트는 127.0.0.1에만 열려 있다(docker-compose.yml). 서버·공유 네트워크에 올릴 때는 반드시 false로.
AUTH_AUTO_LOGIN=true
AUTH_AUTO_LOGIN_USER=admin
# Tailscale로 폰·다른 기기에서 열려면 tailnet 주소(기기이름:8080, 기기이름.tailXXXX.ts.net:8080)를 더한다 — docs/progress.md 참고
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173,127.0.0.1:8080

FILESYSTEM_DISK=local
# SQLite 백업(매일 04:00 KST, 최근 14개). 호스트의 data/backups에 연결됨
BACKUP_PATH=/data/backups

# AI Worker — LLM (키가 없는 공급자는 건너뛴다)
# [API 연결 꺼 둠 2026-09-28] ANTHROPIC_API_KEY=
# [API 연결 꺼 둠 2026-09-28] OPENAI_API_KEY=
# 시도 순서 "provider:model,...". 앞이 실패하면 다음으로 fallback
# 글쓰기는 이 Mac의 구독으로: claude_code(Claude Code)·codex(Codex CLI) — make claude-bridge-install
LLM_ROUTE=claude_code:opus,claude_code:sonnet,codex:gpt-6-astra

# 네이버 Open API (선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

SENTRY_DSN=

# claude-bridge 토큰(make claude-bridge-token 이 만든다). 워커는 host.docker.internal:8790 으로 붙는다
CLAUDE_BRIDGE_TOKEN=
CLAUDE_BRIDGE_URL=http://host.docker.internal:8790

# 최근 1시간 AI 호출 한도(0이면 끔). 토큰 누수 안전장치
LLM_MAX_CALLS_PER_HOUR=60
